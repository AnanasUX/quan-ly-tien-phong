# =====================================================================
# CẤU HÌNH HỆ THỐNG ANX BOT
# Sao chép file này thành .env và điền token MỚI lấy từ @BotFather
# CẢNH BÁO: KHÔNG BAO GIỜ điền token thật vào file này!
# File .env.example chỉ là mẫu, không chứa giá trị thật.
# =====================================================================

# Token Telegram Bot lấy từ @BotFather (BẮT BUỘC)
# Lấy bằng cách: mở @BotFather → chọn bot → /revoke để tạo mới
TELEGRAM_BOT_TOKEN=DAN_TOKEN_MOI_VAO_DAY

# Tên người dùng Quản trị viên trên Telegram (không cần dấu @)
AUTHORIZED_USERNAME=anaa2700

# Khóa API thời tiết OpenWeatherMap
OPENWEATHER_API_KEY=DAN_KEY_VAO_DAY

# Khóa API Google Gemini AI (Tùy chọn cho tính năng chat AI)
GEMINI_API_KEY=DAN_KEY_VAO_DAY

# Cấu hình Google Drive & Docs (Nếu dùng tính năng báo cáo PPT & Docs)
POWERPOINT_FOLDER_ID=YOUR_POWERPOINT_FOLDER_ID_HERE
DOC_LOGIC_ID=YOUR_DOC_LOGIC_ID_HERE
DOC_NEWS_ID=YOUR_DOC_NEWS_ID_HERE

# Webhook Zalo (Nếu có sử dụng)
ZALO_WEBHOOK_URL=https://hook.your-service.com/your-webhook-endpoint
CALENDAR_ID=mrkun28@gmail.com

# Khóa Master Key giải mã Hầm bảo mật CryptoVault (Chỉ quản lý mrkun28@gmail.com sử dụng)
VAULT_MASTER_KEY=YOUR_VAULT_MASTER_KEY_HERE

# Cổng khởi chạy
PORT=10000

# ── Kết nối website React với bot ──────────────────────────────────────────
# URL website thời tiết (Website_thoitiet_design) đang chạy / deploy
# Ví dụ: http://localhost:5173 (local) hoặc https://your-site.vercel.app (deploy)
WEBSITE_URL=http://localhost:5173

# URL public của bot Flask này (để website fetch API /api/daily-news)
# Bỏ trống nếu chưa deploy; khi deploy Render/Railway thì điền vào:
# BOT_API_URL=https://your-bot-server.onrender.com
BOT_API_URL=
